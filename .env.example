# App
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
ASSET_VERSION=local-dev

# Marca do cliente
SITE_NAME=Nome da Pelada
SITE_SHORT_NAME=Pelada
SITE_TAGLINE=Pelada - Stats - Resenha
SITE_DESCRIPTION=Site da pelada com rankings, estatisticas, votacoes, financeiro e imagens para compartilhar.
SITE_INSTAGRAM=@sua_pelada
SITE_INSTAGRAM_URL=https://www.instagram.com/sua_pelada/
SITE_LOGO_PATH=/img/logo-128x128.svg
SITE_LOGO_SMALL_PATH=/img/logo-32x32.svg
SITE_LOGO_LARGE_PATH=/img/logo-512x512.svg
TEAM_LABEL_PREFIX=Time
BRAND_PRIMARY=#ff7a1a
BRAND_SECONDARY=#8b1320
BRAND_BACKGROUND=#050509

# Database
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME
LOCAL_DATABASE_URL=postgresql://YOUR_LOCAL_DB_USER:YOUR_LOCAL_DB_PASSWORD@YOUR_LOCAL_DB_HOST:5432/YOUR_LOCAL_DB_NAME

# Admin seed / auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
JWT_SECRET=CHANGE_ME_JWT_SECRET

# PDF / browser rendering
PUPPETEER_EXECUTABLE_PATH=C:/path/to/chrome.exe
CHROME_PATH=C:/path/to/chrome.exe

# Import scripts
EXCEL_FILE=imports/your-file.xlsx
CSV_FILE=imports/your-file.csv
