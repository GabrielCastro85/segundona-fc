# App
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
ASSET_VERSION=local-dev

# Marca do cliente
SITE_NAME=Segundona FC
SITE_SHORT_NAME=Segundona
SITE_TAGLINE=Futebol - Resenha - Cerveja
SITE_DESCRIPTION=Site oficial da Segundona FC com rankings, estatisticas, votacoes, financeiro e imagens para compartilhar.
SITE_INSTAGRAM=@segundonafc
SITE_INSTAGRAM_URL=https://www.instagram.com/segundonafc/
SITE_LOGO_PATH=/img/logo-128x128.png
SITE_LOGO_SMALL_PATH=/img/logo-32x32.png
SITE_LOGO_LARGE_PATH=/img/logo-512x512.png
TEAM_LABEL_PREFIX=Time
BRAND_PRIMARY=#f5b21b
BRAND_SECONDARY=#0b6b2a
BRAND_BACKGROUND=#050805

# Database
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME
LOCAL_DATABASE_URL=postgresql://YOUR_LOCAL_DB_USER:YOUR_LOCAL_DB_PASSWORD@YOUR_LOCAL_DB_HOST:5432/YOUR_LOCAL_DB_NAME

# Admin seed / auth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
JWT_SECRET=CHANGE_ME_JWT_SECRET

# PDF / browser rendering
PUPPETEER_EXECUTABLE_PATH=C:/path/to/chrome.exe
CHROME_PATH=C:/path/to/chrome.exe

# Import scripts
EXCEL_FILE=imports/your-file.xlsx
CSV_FILE=imports/your-file.csv
